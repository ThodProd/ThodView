{
  "schemaVersion": 1,
  "hubApi": 1,
  "id": "thodview",
  "version": "1.0.6",
  "platform": "win-x64",
  "mode": "standalone",
  "launch": {
    "executable": "app/ThodView.exe",
    "arguments": []
  },
  "permissions": [],
  "cleanup": {
    "arguments": [
      "--uninstall-context"
    ],
    "executable": "app/ThodView.exe"
  },
  "actions": [
    {
      "id": "default-viewer",
      "label": "Сделать просмотрщиком по умолчанию",
      "arguments": [
        "--default-viewer"
      ],
      "waitForExit": true
    }
  ],
  "integration": {
    "arguments": [
      "--register-integrations"
    ],
    "executable": "app/ThodView.exe"
  }
}