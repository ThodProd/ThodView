<Window x:Class="ThodView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ThodView"
        Width="1120" Height="760"
        MinWidth="620" MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBg}"
        AllowDrop="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        MouseMove="Window_MouseMove"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style x:Key="GearButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Border x:Name="TitleBar" Grid.Row="0"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ThodView" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    <Border Width="1" Height="13" Margin="10,0"
                            Background="{DynamicResource LineBrush}"/>
                    <TextBlock x:Name="TitleText" Text="Ничего не открыто" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="620"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleButton}" Content="&#xE921;"
                            ToolTip="Свернуть" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Content="&#xE922;"
                            ToolTip="Развернуть" Click="Maximize_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleButton}" Content="&#xE8BB;"
                            ToolTip="Закрыть" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- image viewport -->
        <Grid x:Name="Viewport" Grid.Row="1" ClipToBounds="True"
              Background="{DynamicResource CanvasBg}" Focusable="True" FocusVisualStyle="{x:Null}"
              SizeChanged="Viewport_SizeChanged"
              MouseWheel="Viewport_MouseWheel"
              MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
              MouseMove="Viewport_MouseMove"
              MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
              MouseLeave="Viewport_MouseLeave">

            <Canvas IsHitTestVisible="False">
            <Image x:Name="PreviewImage" Stretch="Fill"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   RenderTransformOrigin="0,0" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            </Canvas>

            <Canvas x:Name="CropCanvas" Visibility="Collapsed" IsHitTestVisible="False">
                <Rectangle x:Name="CropTop" Fill="#7A000000"/>
                <Rectangle x:Name="CropBottom" Fill="#7A000000"/>
                <Rectangle x:Name="CropLeft" Fill="#7A000000"/>
                <Rectangle x:Name="CropRight" Fill="#7A000000"/>
                <Rectangle x:Name="CropSelection" Fill="Transparent"
                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                           StrokeDashArray="4 3"/>
            </Canvas>

            <Border x:Name="EmptyState" Background="Transparent">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Откройте изображение" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}" FontSize="13"
                               Text="Перетащите изображение сюда"/>
                    <Button Content="Выбрать файл…" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Center" Margin="0,20,0,0" Click="Open_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="LoadingOverlay" Visibility="Collapsed"
                    Background="{DynamicResource CanvasBg}" Opacity="0.92">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}"
                                 BorderThickness="0"/>
                    <TextBlock x:Name="LoadingText" Margin="0,14,0,0" Text="Открываю изображение…"
                               Foreground="{DynamicResource TextMuted}" FontSize="12.5"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- floating gear -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
                <StackPanel>
                    <Button x:Name="GearButton" Style="{StaticResource GearButtonStyle}" Content="&#xE713;"
                            HorizontalAlignment="Right" ToolTip="Настройки и действия"
                            Click="Gear_Click" MouseEnter="Gear_MouseEnter"/>
                    <Border x:Name="GearPanel" Visibility="Collapsed" Width="252" Margin="0,8,0,0"
                            Background="{DynamicResource PanelBg}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="7">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <Button Style="{StaticResource MenuButton}" Click="Open_Click">
                                <Grid><TextBlock Text="Открыть…"/><TextBlock Text="Ctrl+O" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}" FontSize="11"/></Grid>
                            </Button>
                            <Button Style="{StaticResource MenuButton}" Click="Save_Click">
                                <Grid><TextBlock Text="Сохранить как…"/><TextBlock Text="Ctrl+S" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}" FontSize="11"/></Grid>
                            </Button>
                            <Button Style="{StaticResource MenuButton}" Click="OpenFolder_Click">
                                <Grid><TextBlock Text="Открыть папку с файлом"/><TextBlock Text="F" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}" FontSize="11"/></Grid>
                            </Button>
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="6,5"/>
                            <Button Style="{StaticResource MenuButton}" Click="Fit_Click">
                                <Grid><TextBlock Text="Вписать в окно"/><TextBlock Text="0" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}" FontSize="11"/></Grid>
                            </Button>
                            <Button Style="{StaticResource MenuButton}" Click="ActualSize_Click">
                                <Grid><TextBlock Text="Реальный размер"/><TextBlock Text="1" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}" FontSize="11"/></Grid>
                            </Button>
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="6,5"/>
                            <Button Style="{StaticResource MenuButton}" Click="Metadata_Click">
                                <Grid><TextBlock Text="Метаданные…"/><TextBlock Text="M" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}" FontSize="11"/></Grid>
                            </Button>
                            <Button Style="{StaticResource MenuButton}" Click="DefaultViewer_Click">
                                <Grid><TextBlock Text="Открывать изображения…"/><TextBlock Text="Windows" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}" FontSize="11"/></Grid>
                            </Button>
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="6,5"/>
                            <Button x:Name="ThemeButton" Style="{StaticResource MenuButton}" Click="Theme_Click">
                                <Grid><TextBlock x:Name="ThemeLabel" Text="Тема: авто"/><TextBlock Text="T" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}" FontSize="11"/></Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- quick edit toolbar -->
            <Border x:Name="EditToolbar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="64,0,0,14" Padding="4" CornerRadius="13"
                    RenderTransformOrigin="0,0.5" Opacity="1"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToolbarTransform" X="-18"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="↺" ToolTip="Повернуть влево (Shift+R)" Click="RotateLeft_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="↻" ToolTip="Повернуть вправо (R)" Click="RotateRight_Click"/>
                    <Border Width="1" Height="24" Margin="3,0" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource ToolButton}" Content="⇋" ToolTip="Отразить по горизонтали (H)" Click="FlipHorizontal_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="⇅" ToolTip="Отразить по вертикали (V)" Click="FlipVertical_Click"/>
                    <Border Width="1" Height="24" Margin="3,0" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource ToolButton}" Content="⛶" ToolTip="Обрезать (C)" Click="Crop_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                            ToolTip="Метаданные (M)" Click="Metadata_Click"/>
                </StackPanel>
            </Border>

            <Button x:Name="EditToggleButton" Style="{StaticResource GearButtonStyle}" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,14"
                    Content="&#xE70F;" ToolTip="Показать инструменты (поворот, отражение, обрезка)"
                    Click="EditToggle_Click"/>

            <!-- previous / next image in the same folder -->
            <Border x:Name="FolderNav" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,16" Padding="5" CornerRadius="14"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    MouseEnter="FolderNav_MouseEnter" MouseLeave="FolderNav_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource NavButtonStyle}" Content="&#xE76B;" ToolTip="Предыдущее изображение (←)" Click="Previous_Click"/>
                    <TextBlock x:Name="FolderCounter" Text="" VerticalAlignment="Center" MinWidth="58"
                               TextAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="11.5"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="&#xE76C;" ToolTip="Следующее изображение (→)" Click="Next_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="CropBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,18" Padding="12,9" CornerRadius="11"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Выделите область мышью" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="2,0,14,0"/>
                    <Button Content="Обрезать" Style="{StaticResource AccentButton}" Padding="12,6" Click="CropApply_Click"/>
                    <Button Content="Отмена" Style="{StaticResource FlatButton}" Padding="12,6" Margin="6,0,0,0" Click="CropCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- status -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock x:Name="StatusLeft" Text="Готово" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" MaxWidth="440" HorizontalAlignment="Left"/>
                <TextBlock x:Name="StatusCenter" Text="" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" FontSize="11.5" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="OpenFolderButton" Style="{StaticResource FlatButton}" Width="24" Height="24" Padding="0"
                            FontFamily="Segoe MDL2 Assets" FontSize="13" Content="&#xE8B7;"
                            ToolTip="Открыть папку с файлом (F)" Click="OpenFolder_Click" IsEnabled="False"/>
                    <TextBlock x:Name="StatusRight" Text="—" VerticalAlignment="Center" Margin="4,0,0,0"
                               Foreground="{DynamicResource TextMuted}" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
