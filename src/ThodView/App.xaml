<Application x:Class="ThodView.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#0E1015"/>
        <SolidColorBrush x:Key="PanelBg" Color="#151920"/>
        <SolidColorBrush x:Key="CanvasBg" Color="#0B0D11"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EDF1F7"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B94A6"/>
        <SolidColorBrush x:Key="LineBrush" Color="#242A35"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#1D2330"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF"/>
    </Application.Resources>
</Application>
